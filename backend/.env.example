# Postgres connection — local dev via docker-compose uses these defaults
DATABASE_URL=postgresql://sanket:sanket@localhost:5432/sanket

# App
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# CORS — comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ingestion (filled in when Reddit/Telegram ingestion is added)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sanket-ingestion/0.1

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
